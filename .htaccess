# Configuración para Apache (XAMPP y la mayoría de hostings: InfinityFree, Hostinger, 000webhost…).
DirectoryIndex index.php
Options -Indexes

# Archivos que nunca deben verse desde el navegador (salvo robots.txt y la clave de IndexNow, que leen los buscadores).
<FilesMatch "^(?!robots\.txt$|[0-9a-f]{32}\.txt$).*\.(sql|md|txt|bat|py|zip|log|ejemplo\.php)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Carpetas internas (configuración, datos, código compartido, copias para publicar).
    RewriteRule ^(config|data|includes|sql|publicar|quizpy)(/|$) - [F,L]

    # Buscadores (Google, Bing…): robots.txt y sitemap.xml se generan con el dominio real.
    RewriteRule ^robots\.txt$ robots.php [L]
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # Forzar https (candado). Actívalo quitando el "#" de las 4 líneas de abajo SOLO cuando
    # tu hosting ya tenga el certificado SSL instalado (si no, la página dejaría de abrir).
    # RewriteCond %{HTTPS} off
    # RewriteCond %{HTTP:X-Forwarded-Proto} !https
    # RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Nadie puede meter la página en un <iframe> de otro sitio (clickjacking), ni cargar plugins
    # (<object>), ni cambiar la base de los enlaces relativos (<base>).
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
    # Cámara solo para esta página (acceso facial); micrófono, ubicación, pagos y USB, para nadie.
    Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
    Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
    # HSTS: el navegador recuerda usar siempre https. Solo se envía si la visita ya llegó por https
    # (variable HTTPS del Dockerfile), así XAMPP en http://localhost no se ve afectado.
    Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
    Header always unset X-Powered-By
</IfModule>
